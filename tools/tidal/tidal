#!/usr/bin/env bash
# Wrapper: runs tidal_curator.py inside a private venv (created on first use).
# A venv sidesteps Debian's system setuptools, which can't build tidalapi's deps.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
venv="${TIDAL_VENV:-$HOME/.cache/tidal-curator-venv}"
if [ ! -x "$venv/bin/python" ] || ! "$venv/bin/python" -c "import tidalapi" 2>/dev/null; then
  python3 -m venv "$venv" >&2
  "$venv/bin/pip" install -q --disable-pip-version-check -r "$here/requirements.txt" >&2
fi
exec "$venv/bin/python" "$here/tidal_curator.py" "$@"
